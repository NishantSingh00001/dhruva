# All optional. See README for the full list used by main.go (ADDR/PORT, DATABASE_URL, API_KEY, etc).

# Condense/Kafka telemetry ingestion (optional, additive to POST /vehicles/location).
# Leave KAFKA_BROKERS unset to disable this entirely.
KAFKA_BROKERS=broker1.condense.example:9092,broker2.condense.example:9092
KAFKA_TOPIC=vehicle-telemetry
KAFKA_GROUP_ID=dhruva-geofencing
KAFKA_USERNAME=
KAFKA_PASSWORD=
# plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_MECHANISM=plain
# 1 to force TLS even with no username/password set; auto-enabled when a username is set.
KAFKA_TLS=
